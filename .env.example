# Copia este archivo a `.env` (está en .gitignore) o carga estas variables en Vercel.

# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/dbname?sslmode=require
SECRET_KEY=cambiar-en-produccion

# --- Almacenamiento de archivos (Cloudflare R2) ------------------------------
# storage.py las lee con os.environ.get: si falta alguna, is_configured() da
# False y el sistema sigue arrancando pero sin poder subir ni servir archivos.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=access-key-id-del-token-de-r2
R2_SECRET_KEY=secret-access-key-del-token-de-r2
R2_BUCKET=ciencias-ucv-archivo

# --- Backup programado -------------------------------------------------------
# Vercel Cron llama a /api/admin/backup/programado una vez al dia y la copia se
# guarda en R2. Sin CRON_SECRET el endpoint se rechaza: seria una descarga
# completa de la base abierta a cualquiera. Vercel envia el valor en la cabecera
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=cadena-larga-y-aleatoria

# --- Asistente IA ------------------------------------------------------------
# La clave vive SOLO aquí, del lado del servidor. El navegador habla con /api/ia/*
# y es FastAPI quien llama a OpenRouter: si la clave viajara al front, cualquiera
# la lee del bundle. Si falta, la burbuja de chat simplemente no aparece.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Las tres de abajo son solo el RESPALDO ---------------------------------
# El modelo y los topes se editan desde /admin/ia y viven en la tabla `ia_config`.
# Estas variables se usan únicamente mientras nadie haya elegido nada. El motivo:
# en Vercel cambiar una variable obliga a redesplegar, y nadie hace un deploy para
# subir el tope de gasto un día de mucho uso.

# Slug de OpenRouter: lleva prefijo de proveedor y PUNTO. El catálogo real se
# consulta desde /admin/ia; no se adivina. Prohibido cualquier modelo que no
# empiece con "mistralai/" — current_model() lo fuerza igual aunque se ponga otro.
OPENROUTER_MODEL=mistralai/ministral-3b-2512

# Tope de tokens por respuesta. La salida es el grueso del costo de un mensaje.
IA_MAX_TOKENS=1500

# Tope de gasto DIARIO en dólares. Corta antes de llamar al modelo: la idea es no
# hacer la llamada. El costo descontrolado es el riesgo del día uno.
IA_TOPE_DIARIO=1.00

IA_HABILITADA=true

# Solo para la cabecera de atribución en el panel de OpenRouter.
APP_URL=https://ciencias-ucv-digital-archive.vercel.app
