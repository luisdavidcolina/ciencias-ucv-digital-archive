# Copia este archivo a `.env` (está en .gitignore) o carga estas variables en Vercel.

# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/dbname?sslmode=require
SECRET_KEY=cambiar-en-produccion

# --- Asistente IA ------------------------------------------------------------
# La clave vive SOLO aquí, del lado del servidor. El navegador habla con /api/ia/*
# y es FastAPI quien llama a OpenRouter: si la clave viajara al front, cualquiera
# la lee del bundle. Si falta, la burbuja de chat simplemente no aparece.
OPENROUTER_API_KEY=sk-or-v1-...

# Slug de OpenRouter: lleva prefijo de proveedor y PUNTO. `claude-haiku-4-5` (el id
# nativo de Anthropic) da error de modelo inexistente. El catálogo real se consulta
# desde /admin/ia; no se adivina.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Tope de gasto por respuesta.
IA_MAX_TOKENS=1500

# Tope de gasto DIARIO en dólares. Corta antes de llamar al modelo: la idea es no
# hacer la llamada. El costo descontrolado es el riesgo del día uno.
IA_TOPE_DIARIO=1.00

IA_HABILITADA=true

# Solo para la cabecera de atribución en el panel de OpenRouter.
APP_URL=https://ciencias-ucv-digital-archive.vercel.app
